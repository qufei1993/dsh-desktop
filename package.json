{
  "name": "dsh-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "A community-maintained desktop client for DeepSeek Harness",
  "license": "MIT",
  "author": "qufei1993",
  "homepage": "https://github.com/qufei1993/dsh-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/qufei1993/dsh-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/qufei1993/dsh-desktop/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "desktop",
    "electron"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:official": "tsx scripts/smoke-official-dsh.ts",
    "test:packaged": "tsx scripts/e2e-packaged.ts",
    "audit:boundary": "tsx scripts/audit-boundary.ts",
    "release:metadata": "tsx scripts/generate-release-metadata.ts",
    "release:notes": "node scripts/extract-changelog.mjs",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "verify": "npm run version:check && npm run typecheck && npm test && npm run build && npm run audit:boundary",
    "prepare:runtime": "tsx scripts/prepare-resources.ts",
    "package:mac:arm64": "npm run prepare:runtime -- --platform=darwin --arch=arm64 && npm run build && electron-builder --mac --arm64 --publish never --config.publish.channel=latest-arm64 && npm run release:metadata",
    "package:mac:x64": "npm run prepare:runtime -- --platform=darwin --arch=x64 && npm run build && electron-builder --mac --x64 --publish never --config.publish.channel=latest-x64 && npm run release:metadata",
    "package:win:x64": "npm run prepare:runtime -- --platform=win32 --arch=x64 && npm run build && electron-builder --win --x64 --publish never && npm run release:metadata"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "7.8.5",
    "write-file-atomic": "8.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.1",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright-core": "1.62.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "dev.dsh.desktop",
    "productName": "DSH Desktop",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build-resources/runtime",
        "to": "runtime"
      },
      {
        "from": "build-resources/dsh",
        "to": "dsh"
      },
      {
        "from": "build/menu-version-manager.png",
        "to": "ui/version-manager.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "qufei1993",
      "repo": "dsh-desktop",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "sign": "./scripts/sign-macos.cjs",
      "notarize": false,
      "target": [
        "dmg"
      ],
      "artifactName": "DSH-Desktop-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis",
      "artifactName": "DSH-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
